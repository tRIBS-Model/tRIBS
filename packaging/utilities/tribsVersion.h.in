/***************************************************************************
**
**  tribsVersion.h.in: Template for the generated version header.
**
**  Lives here rather than in src/Headers because it is not a compilable
**  header: the @...@ placeholders are substituted by the GitVersion.cmake
**  script alongside it, which writes the result into the build tree as
**  tribsVersion.h. Do not edit the generated header, it is rewritten on
**  every build. To bump the version, edit TRIBS_VERSION and TRIBS_RELEASE in
**  CMakeLists.txt.
**
***************************************************************************/

#ifndef TRIBSVERSION_H
#define TRIBSVERSION_H

//=========================================================================
//
//
//                  Section 1: Version and Build Provenance
//
//
//=========================================================================

// Semantic version, shared with project(... VERSION ...) in CMakeLists.txt.
#define TRIBS_VERSION "@TRIBS_VERSION@"

// Human-readable release label (e.g. "Summer 2026").
#define TRIBS_RELEASE "@TRIBS_RELEASE@"

// Short git hash of the tree this binary was built from, with a "-dirty" suffix
// when tracked files differed from HEAD.
#cmakedefine TRIBS_GIT_SHA "@TRIBS_GIT_SHA@"

#endif

//=========================================================================
//
//                     End of tribsVersion.h.in
//
//=========================================================================
